# Apache / LiteSpeed config for shared hosting.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Old pages from the previous site
  RewriteRule ^aboutme\.html$ /#experience [NE,L,R=301]
  RewriteRule ^ict\.html$ /#experience [NE,L,R=301]
  RewriteRule ^tools\.html$ /#experience [NE,L,R=301]
  RewriteRule ^blog\.html$ /writing/ [L,R=301]
  RewriteRule ^(elements|faq)\.html$ / [L,R=301]
  RewriteRule ^docs/JOSH(\ |%20)UPDATED(\ |%20)CV\.pdf$ /docs/Joshua-Odubu-CV.pdf [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Keep repository files off the web
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
